  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "setup": "bun run scripts/setup.ts",
    "setup:db": "bun run scripts/setup.ts --skip-supabase",
    "postinstall": "node -e \"console.log('\\n  LibreNote AI ready. Run: bun run setup\\n')\"",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
