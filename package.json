{
  "name": "librenoteai",
  "version": "0.1.0",
  "description": "The open-source, self-hosted alternative to NotebookLM. Spins up locally in one command. Powered by any model via OpenRouter.",
  "license": "MIT",
  "author": "Devyansh Yadav <hello@devyanshyadav.com>",
  "repository": {
    "type": "git",
