# LibreNote AI — copy to `.env.local` or run `bun run setup` for local development.

# Optional — powers chat, embeddings, and studio. Get one at https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# Supabase (required)
# Local: written automatically by `bun run setup`
# Cloud: Project Settings → API → Project URL and anon/public key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alias supported for cloud dashboards that label it "anon key":
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Postgres connection string (required for Drizzle / server queries)
# Local: written by `bun run setup`
# Cloud: Project Settings → Database → use the direct or session pooler URI
DATABASE_URL=
